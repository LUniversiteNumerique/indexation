{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title 'Profile utilisateur' %}

{% block page_actions %}
    <a class="btn btn-primary" href="{{ path('app_profile_edit') }}">Editer le profile</a>
    <a class="btn btn-danger" href="{{ path('app_profile_change') }}">Changer le mot de passe</a>
{% endblock %}

{% block main %}
    <div class="example-wrapper">
        <h1>Hello {{ app.user }}! ✅</h1>
        {% if is_granted('ROLE_ADMIN') %}
            This friendly message is coming from:
            <ul>
                <li>Your controller at <code><a href="{{ '/var/www/app/src/Controller/ProfilController.php'|file_link(0) }}">src/Controller/ProfilController.php</a></code></li>
                <li>Your template at <code><a href="{{ '/var/www/app/templates/profil/index.html.twig'|file_link(0) }}">templates/profil/index.html.twig</a></code></li>
            </ul>
        {% endif %}
    </div>
{% endblock %}
