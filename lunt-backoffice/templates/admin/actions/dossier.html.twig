{% extends '@!EasyAdmin/crud/detail.html.twig' %}

{% set curritem = entity.instance %}


{% block page_actions %}
  <a href="{{ ea_url().setController('App\\Controller\\NoticeCrudController').setAction('new').set('folderId', curritem.id) }}" class="btn btn-sm btn-success">Créer Notice</a>
  <a href="{{ ea_url().setController('App\\Controller\\DossierCrudController').setAction('new').setEntityId(curritem.id) }}" class="btn btn-sm btn-primary">Créer Dossier</a>
  {% for action in entity.actions %}
    {{ include(action.templatePath, { action: action }, with_context = false) }}
  {% endfor %}
  {% if curritem.parent %}
    <a href="{{ ea_url().setController('App\\Controller\\DossierCrudController').setAction('detail').setEntityId(curritem.parent.id) }}" class="btn btn-secondary"><i class="fa fa-arrow-up" aria-hidden="true"></i> Retourner</a>
  {% else %}
    <a href="{{ ea_url().setController('App\\Controller\\DossierCrudController').setAction('index') }}" class="btn btn-secondary"><i class="fa fa-arrow-up" aria-hidden="true"></i> Retourner</a>
  {% endif %}
{% endblock %}


{% block detail_fields %}
  {{ include('breadcrumb.html.twig', {bcrumb: getCurrentParents(curritem)}, with_context = false) }}

  <table class="table datagrid">
    <tbody>
    {% for d in curritem.children %}
      <tr>
        <th scope="row"><i class="fa fa-folder fa-xl" aria-hidden="true"></i></th>
        <td>
          <a href="{{ ea_url().setController('App\\Controller\\DossierCrudController').setAction('detail').setEntityId(d.id) }}">{{ d.nom }}</a>
          <p>Modifié le : {{ d.creeLe|date('d/m/Y') }} Par : {{ app.user }}</p>
        </td>
        <td><a href="{{ ea_url().setController('App\\Controller\\DossierCrudController').setAction('edit').setEntityId(d.id) }}" class="btn btn-sm btn-link-danger"><i class="fa fa-pencil" aria-hidden="true"></i></a></td>
      </tr>
    {% endfor %}
    {% for n in curritem.notices %}
      <tr>
        <th scope="row"><i class="fa fa-sticky-note-o fa-xl" aria-hidden="true"></i></th>
        <td>
          <a href="{{ ea_url().setController('App\\Controller\\NoticeCrudController').setAction('detail').setEntityId(n.id).set('folderId', curritem.id) }}">{{ n.titre }}</a>
          <p>Modifié le : {{ n.editeLe|date('d/m/Y') }} <span class="badge badge-{{ n.etat.color }}">{{ n.etat.label }}</span>
        </td>
        <td>
          <button type="button" class="btn btn-sm btn-light move-action" data-bs-toggle="modal" data-bs-target="#moveModal" value="{{ n.id }}">
            <i class="fa fa-arrow-circle-right" aria-hidden="true"></i>
          </button>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <div id="moveModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      {{ form_start(form, {'attr':{'id':"formove", 'class':"modal-content"}}) }}
        <div class="modal-header"><h4>Déplacer Notice</h4></div>

        <div class="modal-body">{{ form_widget(form) }}</div>
        <div class="modal-footer">
          <button type="button" data-bs-dismiss="modal" class="btn btn-secondary">
            <span class="btn-label">{{ 'action.cancel'|trans([], 'EasyAdminBundle') }}</span>
          </button>

          <button type="submit" class="btn btn-primary">
            <i class="fa fa-send" aria-hidden="true"></i> Sauvegarder
          </button>
        </div>
      {{ form_end(form) }}
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const url = '?crudAction=moveNotice&crudControllerFqcn=App%5CController%5CNoticeCrudController&entityId=';
      document.querySelectorAll(".move-action").forEach(action => {
        action.addEventListener("click", () => {
          const form = document.getElementById("formove");
          form.addEventListener("submit", e => {
            e.preventDefault();
            form.action = url+action.value;
            form.submit(); //form.reset()
          });
        });
      });
    });
  </script>

{% endblock detail_fields %}

