{% extends '@!EasyAdmin/crud/detail.html.twig' %}

{% block page_actions %}
    {% for action in entity.actions %}
        {{ include(action.templatePath, { action: action }, with_context = false) }}
    {% endfor %}

    {% if curritem is defined %}
        <a href="{{ ea_url().setController('App\\Controller\\DossierCrudController').setAction('detail').setEntityId(curritem.id) }}" class="btn btn-outline-secondary">Retourner</a>
    {% endif %}

{% endblock %}

{% block main %}
    {% if curritem is defined %}
        {{ include('breadcrumb.html.twig', {bcrumb: getCurrentParents(curritem)}, with_context = false) }}
    {% endif %}

    {% set notId = entity.primaryKeyValue %}

    <div id="modal-confirm" class="modal fade" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" id="confirm-form" class="modal-content" action="{{ ea_url().setController('App\\Controller\\NoticeCrudController').setAction('labelNotice').setEntityId(notId) }}">
                <div class="modal-header"><h4>Catégoriser la notice {{ notId }}</h4></div>
                <div class="modal-body">
                    <input type="text" id="label" name="label" class="form-control" placeholder="Entrer la catégorie" required autofocus>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </div>
                <div class="modal-footer">
                    <button type="button" data-bs-dismiss="modal" class="btn btn-secondary">
                        <span class="btn-label">{{ 'action.cancel'|trans([], 'EasyAdminBundle') }}</span>
                    </button>

                    <button type="submit" class="btn btn-primary" id="modal-confirm-button">
                        <i class="fa fa-send" aria-hidden="true"></i> Sauvegarder
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="modal-reject" class="modal fade" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" id="reject-form" class="modal-content" action="{{ ea_url().setController('App\\Controller\\NoticeCrudController').setAction('rejectNotice').setEntityId(notId) }}">
                <div class="modal-header"><h4>Rejeter cette notice</h4></div>
                <div class="modal-body">
                    <textarea type="text" name="motifs" rows="10" class="form-control" placeholder="Entrer les motifs du rejet" required autofocus></textarea>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </div>
                <div class="modal-footer">
                    <button type="button" data-bs-dismiss="modal" class="btn btn-secondary">
                        <span class="btn-label">{{ 'action.cancel'|trans([], 'EasyAdminBundle') }}</span>
                    </button>

                    <button type="submit" class="btn btn-primary" id="modal-reject-button">
                        <i class="fa fa-send" aria-hidden="true"></i> Sauvegarder
                    </button>
                </div>
            </form>
        </div>
    </div>

    {{ parent() }}
{% endblock main %}
