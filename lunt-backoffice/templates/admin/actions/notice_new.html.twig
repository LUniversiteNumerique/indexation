{% extends '@!EasyAdmin/crud/new.html.twig' %}

{% block page_actions %}
    {% for action in entity.actions %}
        {% if curritem is defined and action.name == 'index' %}
            <a href="{{ ea_url().setController('App\\Controller\\DossierCrudController').setAction('detail').setEntityId(curritem.id) }}" class="btn btn-secondary">{{ 'action.index'|trans([], 'EasyAdminBundle') }}</a>
        {% else %} {{ include(action.templatePath, { action: action }, with_context = false) }} {% endif %}
    {% endfor %}
{% endblock %}

{% block main %}
    {% if curritem is defined %}
        {{ include('breadcrumb.html.twig', {bcrumb: getCurrentParents(curritem)}, with_context = false) }}
    {% endif %}

    {{ parent() }}
{% endblock main %}
