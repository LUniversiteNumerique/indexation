{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title 'Profil utilisateur' %}

{% block page_actions %}
    <a class="btn btn-primary" href="{{ path('app_profile_edit') }}">Editer le profil</a>
    <a class="btn btn-outline-danger" href="{{ path('app_profile_change') }}">Changer le mot de passe</a>
    <a class="btn btn-outline-secondary" href="{{ path('app_home') }}">Retourner</a>
{% endblock %}

{% block main %}
    <div class="mb-4">
        <span>Nom utilisateur</span>
        <strong>{{ app.user }}</strong>
    </div>
    <div class="mb-4">
        <span>Adresse email</span>
        <strong>{{ app.user.email }}</strong>
    </div>
    <div class="mb-4">
        <span>Profil</span>
        <strong class="badge badge-outline">{{ app.user.group }}</strong>
    </div>

{% endblock %}
