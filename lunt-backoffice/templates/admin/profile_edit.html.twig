{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title 'Édition du profil utilisateur' %}

{% block page_actions %}
    <a class="btn btn-outline-primary" href="{{ path('app_profile') }}">Retour au profil</a>
{% endblock %}

{% block main %}
    {{ form_start(form) }}
        {{ form_widget(form) }}

        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save" aria-hidden="true"></i> Sauvegarder la modification
        </button>
    {{ form_end(form) }}
{% endblock %}

