{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title 'Statistiques des notices disponibles' %}

{% block main %}
    <div class="row row-cols-1 row-cols-md-2 align-items-md-center g-5">
        <div class="col d-flex flex-column align-items-start gap-2">
            <p class="text-body-secondary">Ces chiffres proviennent des différents statuts des notices et sont mis à jour en temps réel à chaque actualisation de cette page. Pour gérer ces notices, cliquez sur les liens ci-dessous.</p>

        </div>

        <div class="col">
            <div class="row row-cols-1 row-cols-sm-3 g-6">
                {% set icons = {'Working':'ban', 'Forward':'bell', 'Approved':'check-circle'} %}
                {% for s in noEtats %}
                <div class="col d-flex flex-column gap-2">
                    <div class="feature-icon-small d-inline-flex align-items-center justify-content-center text-bg-light bg-gradient fs-4 rounded-5">
                        <h1 class="fw-bold mb-0">{{ s.nombre }}</h1> <svg class="bi" width="1em" height="1em"><i class="fa fa-{{ icons[s.etat.name] }} fa-2x"></i></svg>
                    </div>
                    <p class="text-body-secondary">{{ s.etat.label }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <table class="table datagrid {{ notices is empty ? 'datagrid-empty' }} mt-4">
        {% if notices %}
            <thead>
            {% block table_head %}
                <tr>
                    <th data-column="titre"><span>Titre</span></th>
                    <th data-column="auteurs"><span>Auteurs</span></th>
                    <th data-column="ressUrl"><span>Contenu URL</span></th>
                    <th data-column="specialite"><span>Spécialité</span></th>
                    <th data-column="editeLe"><span>Modifié Le</span></th>
                    <th data-column="codewey"><span>Code Dewey</span></th>
                    <th data-column="vignette"><span>Vignette</span></th>
                    <th data-column="actions"></th>
                </tr>
            {% endblock table_head %}
            </thead>
        {% endif %}

        <tbody>
        {% block table_body %}
            {% for entity in notices %}
                    <tr data-id="{{ entity.id }}">
                        <td>{{ entity.titre }}</td>
                        <td>
                            {% for key,value in entity.auteurs %}
                                <span class="badge badge-custom">{{ value }}</span>
                            {% endfor %}
                        </td>
                        <td><a target="_blank" rel="noopener" href="{{ entity.ressUrl }}">{{ entity.ressUrl|slice(0, 15) }}...</a></td>
                        <td>
                            {% for key,value in entity.specialites %}
                                <span class="badge badge-custom">{{ value }}</span>
                            {% endfor %}
                        </td>
                        <td><time datetime="{{ entity.editeLe|date('c') }}" title="{{ entity.editeLe|date('r') }}">{{ entity.editeLe|date("d/m/Y") }}</time></td>
                        <td>
                            {% for key,value in entity.codeweys %}
                                <span class="badge badge-custom">{{ value }}</span>
                            {% endfor %}
                        </td>
                        <td><div class="ea-lightbox-thumbnail">
                            {% if entity.vignette %}<img src="{{ asset('uploads/images/'~entity.vignette) }}">{% endif %}
                        </div></td>
                        <td class="actions"><a href="{{ ea_url().setController('App\\Controller\\NoticeCrudController').setAction('detail').setEntityId(entity.id) }}" class="btn btn-outline-secondary">{{ 'action.detail'|trans([], 'EasyAdminBundle') }}</a></td>
                    </tr>
            {% else %}
                {% block table_body_empty %}
                    <tr class="no-results">
                        <td colspan="100">
                            {{ t('datagrid.no_results', ea.i18n.translationParameters, 'EasyAdminBundle')|trans }}
                        </td>
                    </tr>
                {% endblock table_body_empty %}
            {% endfor %}

        {% endblock table_body %}
        </tbody>

        <tfoot>{% block table_footer %}{% endblock table_footer %}</tfoot>
    </table>
{% endblock %}
