{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title 'Changement de mot de passe' %}

{% block page_actions %}
    <a class="btn btn-outline-primary" href="{{ path('app_profile') }}">Annuler</a>
{% endblock %}

{% block main %}
    <div class="alert alert-info" role="alert">Après avoir modifié votre mot de passe, vous serez déconnecté de l'application.</div>

    {{ form_start(form) }}
    {{ form_widget(form) }}

    <button type="submit" class="btn btn-primary">
        <i class="fa fa-save" aria-hidden="true"></i> Sauvegarder
    </button>
    {{ form_end(form) }}
{% endblock %}